        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"company_name\": \"John's Widgets\",\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{base_url}}/api/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const token = ((body && body.data && (body.data.token || (body.data.data && body.data.data.token))) || (body && body.token));",
                  "if (token) {",
                  "  pm.collectionVariables.set('auth_token', token);",
                  "  pm.environment.set('auth_token', token);",
                  "  console.log('Auth token saved:', token);",
                  "}",
                  "pm.test('Register returns success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
